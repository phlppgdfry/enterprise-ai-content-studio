# ==============================================================================
# Enterprise AI Content Automation Studio - Environment Variables
# ==============================================================================

# Descript API Configuration
# Get your API Key in Descript -> Settings -> Developer / API
DESCRIPT_API_KEY=""
DESCRIPT_API_URL="https://descriptapi.com/v1/"
DESCRIPT_DRIVE_ID=""

# ElevenLabs Configuration (Voice synthesis)
# Free tier gives 10,000 characters/month
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Buffer Configuration (LinkedIn & Social publishing)
BUFFER_ACCESS_TOKEN=""
BUFFER_PROFILE_ID=""

# GitHub Configuration (Release monitoring)
GITHUB_TOKEN=""
GITHUB_REPO="phlppgdfry/enterprise-ai-content-studio"

# Quota & Safe-Run Settings
# Set to 'true' to execute end-to-end without consuming real Descript or ElevenLabs credits
DRY_RUN="true"
MAX_MONTHLY_DESCRIPT_MINUTES="60"
MAX_MONTHLY_ELEVENLABS_CHARS="10000"
AUTO_SIMULATE_ON_QUOTA_EXCEEDED="true"
